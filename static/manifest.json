{
  "manifest_version": 3,
  "name": "osu! preview",
  "description": "Preview an osu! beatmap in your browser.",
  "version": "0.0.6",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://osu.ppy.sh/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_icon": "icon48.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://*.ppy.sh/*",
    "http://*.ppy.sh/*"
  ]
}
